<Application x:Class="ContaNexo.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:ContaNexo.Desktop.ViewModels"
             xmlns:views="clr-namespace:ContaNexo.Desktop.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type viewModels:InicioViewModel}">
                <views:InicioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:EmpresaViewModel}">
                <views:EmpresaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PeriodoContableViewModel}">
                <views:PeriodoContableView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
