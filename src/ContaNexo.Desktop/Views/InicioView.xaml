<UserControl x:Class="ContaNexo.Desktop.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1400"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1720"
              Margin="48,42,48,54"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="76"
                        Height="76"
                        Margin="0,0,24,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource BlueTintBrush}"
                        BorderBrush="#CEE1F8"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <Border Width="38"
                                Height="38"
                                Background="{StaticResource BrandAccentBrush}"
                                CornerRadius="19" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="CN" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="SISTEMA CONTABLE ACADÉMICO" />
                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                               Text="Bienvenido a ContaNexo" />
                    <TextBlock MaxWidth="720"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Left"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Una base clara para organizar el ciclo contable, desde la definición del catálogo hasta la preparación de reportes." />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,42,0,20"
                        HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                           Text="Flujo contable principal" />
                <TextBlock Margin="0,7,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Cada etapa prepara la información necesaria para la siguiente." />
            </StackPanel>

            <WrapPanel Grid.Row="2"
                       HorizontalAlignment="Center">
                <Border Cursor="Hand"
                        Style="{StaticResource ModuleCardStyle}">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding NavegarCatalogoCommand}"
                                      MouseAction="LeftClick" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BlueTintBrush}"
                                    CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandAccentBrush}"
                                           Text="CC" />
                            </Border>
                            <Border Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BlueTintBrush}"
                                    CornerRadius="15">
                                <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="1" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Text="Catálogo de cuentas" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,20"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Define la estructura de cuentas que servirá como base para registrar las operaciones contables." />
                        <TextBlock Grid.Row="3"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandAccentBrush}"
                                   Text="PRIMER PASO  →" />
                    </Grid>
                </Border>

                <Border Cursor="Hand"
                        Style="{StaticResource ModuleCardStyle}">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding NavegarLibroDiarioCommand}"
                                      MouseAction="LeftClick" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource GreenTintBrush}"
                                    CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"
                                           Text="LD" />
                            </Border>
                            <Border Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource GreenTintBrush}"
                                    CornerRadius="15">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"
                                           Text="2" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Text="Libro Diario" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,20"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Registra cronológicamente las operaciones y conserva el detalle de cada asiento contable." />
                        <TextBlock Grid.Row="3"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GreenBrush}"
                                   Text="REGISTRO  →" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource VioletTintBrush}"
                                    CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource VioletBrush}"
                                           Text="LM" />
                            </Border>
                            <Border Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource VioletTintBrush}"
                                    CornerRadius="15">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource VioletBrush}"
                                           Text="3" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Text="Libro Mayor" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,20"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Agrupa los movimientos por cuenta para facilitar su consulta y el análisis de saldos." />
                        <TextBlock Grid.Row="3"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource VioletBrush}"
                                   Text="CLASIFICACIÓN  →" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModuleCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AmberTintBrush}"
                                    CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AmberBrush}"
                                           Text="Σ" />
                            </Border>
                            <Border Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource AmberTintBrush}"
                                    CornerRadius="15">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AmberBrush}"
                                           Text="4" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Text="Balance de Sumas y Saldos" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,12,0,20"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Presenta la comprobación de movimientos y saldos como cierre del flujo contable principal." />
                        <TextBlock Grid.Row="3"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AmberBrush}"
                                   Text="COMPROBACIÓN" />
                    </Grid>
                </Border>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
