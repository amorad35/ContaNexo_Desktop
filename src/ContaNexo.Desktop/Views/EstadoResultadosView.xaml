<UserControl x:Class="ContaNexo.Desktop.Views.EstadoResultadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1400"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="EstadoResultadosEstadoPanelStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="230" />
            <Setter Property="Margin" Value="0,28,0,0" />
            <Setter Property="Padding" Value="34" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="EstadoResultadosSinPeriodoStyle"
               BasedOn="{StaticResource EstadoResultadosEstadoPanelStyle}"
               TargetType="Border">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding TienePeriodoActivo}" Value="False" />
                        <Condition Binding="{Binding EstaCargando}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoResultadosCargandoStyle"
               BasedOn="{StaticResource EstadoResultadosEstadoPanelStyle}"
               TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaCargando}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoResultadosErrorStyle"
               BasedOn="{StaticResource EstadoResultadosEstadoPanelStyle}"
               TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ErrorTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoResultadosContenidoStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding TienePeriodoActivo}" Value="True" />
                        <Condition Binding="{Binding EstaCargando}" Value="False" />
                        <Condition Binding="{Binding TieneError}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoResultadosAdvertenciaStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,24,0,0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="{StaticResource AmberTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneSaldosContrarios}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoResultadosSeccionStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,24,0,0" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="EstadoResultadosCuentaRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ImporteConsolidado}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EstadoResultadosAlertaCuentaStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
            <Setter Property="Text" Value="Saldo contrario" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneSaldoContrario}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="EstadoResultadosGrupoTemplate">
            <Border Margin="0,18,0,0"
                    Padding="16"
                    Background="{StaticResource ContextBarBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="{Binding CodigoGrupo}" />
                        <Run Text=" · " />
                        <Run Text="{Binding NombreGrupo}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Cuentas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Style="{StaticResource EstadoResultadosCuentaRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Width="82"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding CodigoCuenta}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding NombreCuenta}" />
                                        <TextBlock Style="{StaticResource EstadoResultadosAlertaCuentaStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               MinWidth="130"
                                               HorizontalAlignment="Right"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding ImporteConsolidado, StringFormat={}{0:N2}}"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Subtotal del grupo" />
                        <TextBlock Grid.Column="1"
                                   MinWidth="130"
                                   HorizontalAlignment="Right"
                                   FontFamily="Consolas"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="{Binding TotalGrupo, StringFormat={}{0:N2}}"
                                   TextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,30,32,48"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="REPORTE FINANCIERO" />
                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                               Text="Estado de Resultados" />
                    <TextBlock MaxWidth="670"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Left"
                               Style="{StaticResource BodyTextStyle}"
                               TextAlignment="Left"
                               Text="Presenta los ingresos y gastos del período para determinar su resultado contable." />
                </StackPanel>
                <Border Grid.Column="1"
                        MinWidth="220"
                        Margin="30,0,0,0"
                        Padding="16,12"
                        VerticalAlignment="Top"
                        Background="{StaticResource VioletTintBrush}"
                        BorderBrush="{StaticResource VioletBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource VioletBrush}"
                                   Text="PERÍODO ACTIVO" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="{Binding NombrePeriodoActivo}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding EstadoPeriodoActivo}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1"
                  Width="830"
                  HorizontalAlignment="Center">
                <Border Style="{StaticResource EstadoResultadosSinPeriodoStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                   Text="Selecciona un período contable" />
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Activa o selecciona un período contable antes de consultar el Estado de Resultados." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EstadoResultadosCargandoStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                   Text="Preparando el Estado de Resultados" />
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Se están consolidando los saldos del período seleccionado." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EstadoResultadosErrorStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Text="No se pudo cargar el Estado de Resultados" />
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding MensajeError}" />
                    </StackPanel>
                </Border>

                <StackPanel Style="{StaticResource EstadoResultadosContenidoStyle}">
                    <Border Style="{StaticResource EstadoResultadosAdvertenciaStyle}">
                        <TextBlock FontSize="13"
                                   Foreground="{StaticResource AmberBrush}"
                                   TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Revisión requerida. " />
                            <Run Text="Se detectaron " />
                            <Run FontWeight="SemiBold" Text="{Binding CantidadSaldosContrarios, Mode=OneWay}" />
                            <Run Text=" cuenta(s) con saldo contrario a su naturaleza." />
                        </TextBlock>
                    </Border>

                    <Border Style="{StaticResource EstadoResultadosSeccionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Ingresos" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="Cuentas nominales acreedoras del período." />
                            <ItemsControl ItemsSource="{Binding GruposIngresos}"
                                          ItemTemplate="{StaticResource EstadoResultadosGrupoTemplate}" />
                            <Border Margin="0,22,0,0"
                                    Padding="16,13"
                                    Background="{StaticResource GreenTintBrush}"
                                    CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GreenBrush}"
                                               Text="TOTAL INGRESOS" />
                                    <TextBlock Grid.Column="1"
                                               MinWidth="150"
                                               HorizontalAlignment="Right"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GreenBrush}"
                                               Text="{Binding TotalIngresos, StringFormat={}{0:N2}}"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EstadoResultadosSeccionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Gastos" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="Cuentas nominales deudoras del período." />
                            <ItemsControl ItemsSource="{Binding GruposGastos}"
                                          ItemTemplate="{StaticResource EstadoResultadosGrupoTemplate}" />
                            <Border Margin="0,22,0,0"
                                    Padding="16,13"
                                    Background="{StaticResource ErrorTintBrush}"
                                    CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Text="TOTAL GASTOS" />
                                    <TextBlock Grid.Column="1"
                                               MinWidth="150"
                                               HorizontalAlignment="Right"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Text="{Binding TotalGastos, StringFormat={}{0:N2}}"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,24,0,0"
                            Padding="26,22"
                            Background="{StaticResource VioletTintBrush}"
                            BorderBrush="{StaticResource VioletBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource VioletBrush}"
                                           Text="CIERRE DEL PERÍODO" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="RESULTADO DEL PERÍODO" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       MinWidth="190"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource VioletBrush}"
                                       Text="{Binding ResultadoPeriodo, StringFormat={}{0:N2}}"
                                       TextAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
