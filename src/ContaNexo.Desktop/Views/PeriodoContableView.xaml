<UserControl x:Class="ContaNexo.Desktop.Views.PeriodoContableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1400"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PanelCargaStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaCargando}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelSinEmpresaStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EmpresaNoConfigurada}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding EmpresaNoConfigurada}" Value="True" />
                        <Condition Binding="{Binding EstaCargando}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelErrorStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TieneError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelVacioStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MostrarEstadoVacio}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListadoPeriodosStyle" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TienePeriodos}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormularioCreacionStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MostrarFormulario}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonSeleccionarPeriodoStyle"
               BasedOn="{StaticResource SecondaryActionButtonStyle}"
               TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PuedeSeleccionar}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IndicadorPeriodoActivoStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource BlueTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EsActivo}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonEditarPeriodoStyle"
               BasedOn="{StaticResource SecondaryActionButtonStyle}"
               TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PuedeEditar}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonCerrarPeriodoStyle"
               BasedOn="{StaticResource SecondaryActionButtonStyle}"
               TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PuedeCerrar}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="48,42,48,54"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource EyebrowTextStyle}"
                           Text="CONTABILIDAD" />
                <TextBlock Style="{StaticResource PageTitleTextStyle}"
                           Text="Períodos contables" />
                <TextBlock MaxWidth="760"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Left"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Consulta los períodos registrados para la empresa configurada y su estado actual." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,32,0,0"
                    Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="Períodos registrados" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="Los períodos se muestran del más reciente al más antiguo." />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="24,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ContextLabelTextStyle}"
                                           Text="Empresa:" />
                                <TextBlock Margin="6,0,0,0"
                                           Style="{StaticResource ContextValueTextStyle}"
                                           Text="{Binding NombreEmpresa}" />
                            </StackPanel>
                            <Button MinWidth="132"
                                    Margin="24,0,0,0"
                                    Command="{Binding NuevoPeriodoCommand}"
                                    Content="Nuevo período"
                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,24,0,0"
                            Padding="22"
                            Background="{StaticResource ContextBarBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            IsEnabled="{Binding FormularioHabilitado}"
                            Style="{StaticResource FormularioCreacionStyle}">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding TituloFormulario}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="{Binding DescripcionFormulario}" />

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource ErrorFeedbackTextStyle}"
                                       Text="{Binding MensajeErrorFormulario}" />

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FormLabelTextStyle}"
                                               Text="Nombre del período" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="{Binding NombrePeriodo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FormLabelTextStyle}"
                                               Text="Fecha de inicio" />
                                    <DatePicker MinHeight="40"
                                                Padding="10,7"
                                                VerticalContentAlignment="Center"
                                                FontFamily="Segoe UI"
                                                FontSize="14"
                                                SelectedDate="{Binding FechaInicioPeriodo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FormLabelTextStyle}"
                                               Text="Fecha de fin" />
                                    <DatePicker MinHeight="40"
                                                Padding="10,7"
                                                VerticalContentAlignment="Center"
                                                FontFamily="Segoe UI"
                                                FontSize="14"
                                                SelectedDate="{Binding FechaFinPeriodo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,22,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button MinWidth="106"
                                        Command="{Binding CancelarCreacionCommand}"
                                        Content="Cancelar"
                                        Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button MinWidth="120"
                                        Margin="10,0,0,0"
                                        Command="{Binding GuardarPeriodoCommand}"
                                        Content="{Binding TextoGuardar}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,20,0,0"
                               Style="{StaticResource SuccessFeedbackTextStyle}"
                               Text="{Binding MensajeExito}" />

                    <Border Margin="0,24,0,0"
                            Padding="20"
                            Background="{StaticResource BlueTintBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Style="{StaticResource PanelCargaStyle}">
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Cargando períodos contables..." />
                    </Border>

                    <Border Margin="0,24,0,0"
                            Padding="22"
                            Background="{StaticResource BlueTintBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Style="{StaticResource PanelSinEmpresaStyle}">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Primero configura la empresa" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="No hay una empresa configurada para consultar sus períodos contables." />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,24,0,0"
                            Padding="18"
                            Background="{StaticResource ErrorTintBrush}"
                            BorderBrush="{StaticResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Style="{StaticResource PanelErrorStyle}">
                        <TextBlock Foreground="{StaticResource ErrorBrush}"
                                   Text="{Binding MensajeError}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Margin="0,24,0,0"
                            Padding="28"
                            Background="{StaticResource ContextBarBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Style="{StaticResource PanelVacioStyle}">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Todavía no hay períodos contables" />
                            <TextBlock Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="La empresa configurada aún no tiene períodos registrados." />
                        </StackPanel>
                    </Border>

                    <ItemsControl Margin="0,24,0,0"
                                  ItemsSource="{Binding PeriodosContables}"
                                  Style="{StaticResource ListadoPeriodosStyle}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <StackPanel>
                                    <Border Padding="16,11"
                                            Background="{StaticResource ContextBarBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="270" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="PERÍODO" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="FECHA DE INICIO" />
                                            <TextBlock Grid.Column="2"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="FECHA DE FIN" />
                                            <TextBlock Grid.Column="3"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="ESTADO" />
                                            <TextBlock Grid.Column="4"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="ACCIONES" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter />
                                </StackPanel>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,8,0,0"
                                        Padding="16,14"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsActivo}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BlueTintBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="270" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding NombrePeriodo}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding FechaInicioPeriodo, StringFormat={}{0:dd/MM/yyyy}}" />
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding FechaFinPeriodo, StringFormat={}{0:dd/MM/yyyy}}" />
                                        <Border Grid.Column="3"
                                                HorizontalAlignment="Left"
                                                Padding="11,5"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ContextBarBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstadoPeriodo}" Value="Abierto">
                                                            <Setter Property="Background" Value="{StaticResource GreenTintBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding EstadoPeriodo}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstadoPeriodo}" Value="Abierto">
                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Grid Width="112">
                                                <Button HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.SeleccionarPeriodoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Seleccionar"
                                                        Style="{StaticResource BotonSeleccionarPeriodoStyle}" />
                                                <Border HorizontalAlignment="Left"
                                                        Style="{StaticResource IndicadorPeriodoActivoStyle}">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrandAccentBrush}"
                                                               Text="Activo" />
                                                </Border>
                                            </Grid>
                                            <Button Margin="8,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.EditarPeriodoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"
                                                    Style="{StaticResource BotonEditarPeriodoStyle}" />
                                            <Button Margin="8,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.CerrarPeriodoCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Cerrar"
                                                    Style="{StaticResource BotonCerrarPeriodoStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
