<Window x:Class="ContaNexo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ContaNexo"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="Manual"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Contexto de trabajo: reservado para datos reales en un bloque posterior. -->
        <Border Grid.Row="0"
                Padding="32,10"
                Background="{StaticResource ContextBarBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ContextLabelTextStyle}" Text="Empresa:" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ContextValueTextStyle}"
                               Text="{Binding EmpresaActivaTexto}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Height="18"
                        Margin="24,0"
                        Background="{StaticResource DividerBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ContextLabelTextStyle}" Text="Período:" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ContextValueTextStyle}"
                               Text="{Binding PeriodoActivoTexto}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ContextLabelTextStyle}" Text="Fecha:" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource ContextValueTextStyle}"
                               Text="{Binding FechaActualTexto}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navegación principal. -->
        <Border Grid.Row="1"
                Background="{StaticResource NavigationBrush}"
                BorderBrush="{StaticResource NavigationBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,34,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="38"
                            Height="38"
                            Background="{StaticResource BrandAccentBrush}"
                            CornerRadius="9">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="CN" />
                    </Border>
                    <TextBlock Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="White">
                        <Run Text="Conta" /><Run Foreground="{StaticResource BrandLightBrush}" Text="Nexo" />
                    </TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding NavegarInicioCommand}"
                                Content="Inicio"
                                Style="{StaticResource NavigationButtonStyle}"
                                Tag="{Binding EsInicioActivo}" />
                        <Button Command="{Binding NavegarPeriodosContablesCommand}"
                                Content="Períodos contables"
                                Style="{StaticResource NavigationButtonStyle}"
                                Tag="{Binding EsPeriodosContablesActivo}" />
                        <Button Command="{Binding NavegarCatalogoCommand}"
                                Content="Catálogo de cuentas"
                                Style="{StaticResource NavigationButtonStyle}"
                                Tag="{Binding EsCatalogoActivo}" />
                        <Button Click="AlPulsarOperaciones"
                                Content="Operaciones  ▾"
                                Style="{StaticResource NavigationButtonStyle}">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom"
                                             Style="{StaticResource OperationsMenuStyle}">
                                    <MenuItem Command="{Binding PlacementTarget.DataContext.NavegarLibroDiarioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Header="Libro Diario"
                                              Style="{StaticResource OperationsMenuItemStyle}" />
                                    <MenuItem Command="{Binding PlacementTarget.DataContext.NavegarLibroMayorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Header="Libro Mayor"
                                              Style="{StaticResource OperationsMenuItemStyle}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource NavigationButtonStyle}" Content="Reportes  ▾" />
                        <Button Command="{Binding NavegarEmpresaCommand}"
                                Content="Configuración"
                                Style="{StaticResource NavigationButtonStyle}"
                                Tag="{Binding EsEmpresaActiva}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding VistaActual}" />

    </Grid>
</Window>
